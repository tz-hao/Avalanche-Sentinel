# Application database traffic: use the pooled Neon URL in hosted environments.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# Schema migration traffic only: use the direct (non-pooler) Neon URL.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Required to enable the single-admin session API. Use a long random value.
SENTINEL_ADMIN_PASSWORD=""
SENTINEL_SESSION_SECRET=""

# Optional notification integrations. Leaving these blank records a skipped notification.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
SENTINEL_WEBHOOK_URL=""
SENTINEL_WEBHOOK_SECRET=""

# Optional, summary-only provider. Never used for alert qualification.
AI_SUMMARY_ENDPOINT=""
AI_SUMMARY_API_KEY=""
AI_SUMMARY_MODEL=""

# Explicitly opt in to locally-generated Demo incidents. Notifications remain disabled by default.
SENTINEL_DEMO_MODE="false"
DEMO_NOTIFICATIONS_ENABLED="false"
WORKER_ID="sentinel-worker-local"
